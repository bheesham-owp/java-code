public class MiniDistanceInArray {
    int minDist(int arr[], int x, int y) {
        // code here
        int n = arr.length;
        int idx = -1;
        int idxy = -1;
        int min = Integer.MAX_VALUE;

        for(int i = 0; i < n; i++){
            if(arr[i] == x){
                idx = i;
            }

            if(arr[i] == y){
                idxy = i;
            }

            if(idx != -1 && idxy != -1){
                min = Math.min(min, Math.abs(idx - idxy));
            }
        }

        if(min == Integer.MAX_VALUE){
            return -1;
        }

        return min;
    }
}
