public class RotateArray {
    public void rotateArr(int arr[], int d) {
        // code here
        int n = arr.length;
        int[] temp = new int[n];
        int k = 0;
        for(int i = d; i < n; i++){
            temp[k] = arr[i];
            k++;
        }

        for(int i = 0; i < d; i++){
            arr[k] = temp[i];
            k++;
        }
        for (int i = 0; i < n; i++) {
            arr[i] = temp[i];
        }
    }
}
