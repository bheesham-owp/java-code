package Arrays;

public class SelectionSorting {
    static void selectionSort(int[] arr){
        for (int i = 0; i < arr.length; i++) {
            int min = Integer.MAX_VALUE;
            int idx = -1;
            for (int j = i; j < arr.length ; j++) {
                if(arr[j]< min){
                    min = arr[j];
                    idx = j;
                }
            }
            int temp = arr[i];
            arr[i] =  arr[idx];
            arr[idx] = temp;
        }
    }

    public static void main(String[] args) {
        int[] arr = {32,45,56,76,845,865,48,22,99};
        printSle(arr);
        selectionSort(arr);
        printSle(arr);

    }

    private static void printSle(int[] arr) {
        for (int i = 0; i < arr.length; i++) {
            System.out.print(arr[i] + " ");
        }
        System.out.println();
    }
}
