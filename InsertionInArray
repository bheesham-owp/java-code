package Arrays;

import java.util.Scanner;

public class insertionEle {
    static void main(String[] args) {
        Scanner sc=new Scanner(System.in);
        int[] arr = new int[10];
        arr[0] = 10;
        arr[1] = 20;
        arr[2] = 30;
        arr[3] = 40;
        arr[4] = 50;
        arr[5] = 60;
        arr[6] = 70;
        int n = 7;
        System.out.print("Your Array is");
        for (int i = 0; i < n; i++) {
            System.out.print(arr[i]+" ");
        }
        System.out.println();
        System.out.print("Enter the lcation of the new item between 0 to"+arr.length+":");
        int k = sc.nextInt();
        System.out.print("Enter the new element:");
        int item = sc.nextInt();
        for (int i = n; i >= k ; i--) {
            arr[i+1] = arr[i];
        }
        arr[k] = item;
        n++;
        for (int i = 0; i < n; i++) {
            System.out.print(arr[i]+" ");
        }
        System.out.println();
        System.out.println(arr.length);
    }
}

