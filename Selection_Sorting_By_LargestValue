package Arrays;

public class Sel_Sorting_Find_Largest_Value {
    static void main(String[] args) {
        int[] arr = {32,45,56,76,845,865,48,22,99};
        DisplaySle(arr);
        sel_Largest_value(arr);
        DisplaySle(arr);

    }

    private static void DisplaySle(int[] arr) {
        for (int i = 0; i < arr.length; i++) {
            System.out.print(arr[i]+" ");
        }
        System.out.println();
    }
    static void sel_Largest_value(int[] arr) {
        int n= arr.length;
        for (int i = 0; i < n-1; i++) {
            int max = Integer.MIN_VALUE;
            int idx = -1;
            for (int j = 0; j < n-i; j++) {
               if(arr[j] > max){
                    max = arr[j];
                    idx = j;
               }
            }
            int temp = arr[n-i-1];
            arr[n-i-1] = arr[idx];
            arr[idx] = temp;
        }

    }
}
